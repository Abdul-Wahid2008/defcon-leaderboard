# DEFCON Leaderboard. Copy to .env.local (never commit it). Values below are documentation, not secrets.

# --- Source (EnoEngine scoreboard.json, club-owned). UNCONFIRMED until the club gives the URL and a sample. ---
SCOREBOARD_URL=
# Comma-separated hosts the collector may fetch from. Default: the host of SCOREBOARD_URL.
SCOREBOARD_ALLOWED_HOSTS=
POLL_SEC=15
STALE_AFTER_SEC=270
ROUND_SEC=90

# --- Event ---
EVENT_SLUG=
EVENT_NAME=DEFCON 2.0
# ISO-8601 with offset, e.g. 2026-10-31T10:00:00+05:30. FREEZE_AT_ISO is mandatory in release mode.
EVENT_START_ISO=
FREEZE_AT_ISO=
EVENT_END_ISO=

# --- Display ---
# Publicly showing which service is down helps attackers. Club decision; default off.
SHOW_SERVICE_STATUS=false
# Path prefix if served under a sub-path.
BASE_PATH=

# --- Optional history store (server-side only; NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Public traffic ---
RATE_LIMIT_PER_MIN=120
# true only behind nginx that sets X-Forwarded-For; the right-most entry is used.
TRUST_PROXY=false

# --- Release ---
# 1 makes `npm run check-env` enforce the release rules.
CHECK_RELEASE=
DATA_DIR=./data
